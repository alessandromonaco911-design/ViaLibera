# Copy to .env and change values locally. Never commit .env.

# --- Local development (docker compose, optional) ---
# PostgreSQL container (docker compose)
POSTGRES_DB=scuolaguida
POSTGRES_USER=scuolaguida
POSTGRES_PASSWORD=dev_only_change_me
# Host port exposed by the container (5432 is often taken by other projects)
POSTGRES_PORT=5433

# --- Connection string used by the app and scripts ---
# Local: postgres://user:password@localhost:5433/db
# Remote (Neon): pooled connection string, e.g.
#   postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgres://scuolaguida:dev_only_change_me@localhost:5433/scuolaguida

# --- Media serving policy (optional) ---
# Comma-separated list of media verification statuses allowed in production.
# Default (empty): structurally_verified, ai_visually_verified, visually_verified
# MEDIA_PRODUCTION_ALLOWED_STATUSES=structurally_verified,visually_verified
