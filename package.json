{
  "name": "scuolaguida-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:release": "node --env-file=.env scripts/verify-release.mjs",
    "start:host": "next start --hostname 0.0.0.0",
    "db:maintain-sessions": "tsx --env-file=.env scripts/db/maintain-sessions.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/db/seed.ts",
    "db:import-catalog": "tsx --env-file=.env scripts/db/import-catalog.ts",
    "db:verify-import": "tsx --env-file=.env scripts/db/verify-import.ts",
    "db:cleanup-dev-sessions": "tsx --env-file=.env scripts/db/cleanup-dev-sessions.ts",
    "db:cleanup-expired-exams": "tsx --env-file=.env scripts/db/cleanup-expired-exams.ts",
    "exam:audit-distribution": "tsx --env-file=.env scripts/data/exam-distribution-audit.ts",
    "test": "node --import tsx --env-file=.env --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "data:audit": "tsx --env-file=.env scripts/data/audit.ts",
    "data:download": "tsx --env-file=.env scripts/data/download.ts",
    "data:parse": "tsx --env-file=.env scripts/data/parse.ts",
    "data:validate": "tsx --env-file=.env scripts/data/validate.ts",
    "review:sample": "tsx scripts/review/sample.ts",
    "review:gallery": "tsx scripts/review/gallery.ts",
    "review:export": "tsx scripts/review/export.ts",
    "review:import": "tsx --env-file=.env scripts/review/import-external-ai.ts",
    "explanations:audit": "node scripts/review/audit-explanations.mjs",
    "explanations:require-complete": "node scripts/review/audit-explanations.mjs --require-complete",
    "data:figure-audit": "tsx scripts/data/figure-audit.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@napi-rs/canvas": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "unpdf": "^1.8.0"
  }
}
